generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ApplicationStatus {
  discovered
  shortlisted
  prepared
  applied
  oa_received
  interview
  rejected
  offer
}

model Job {
  id             String        @id @default(cuid())
  company        String
  title          String
  jd             String
  url            String        @unique
  location       String?
  source         String
  salaryEstimate String?
  fitScore       Float?
  compensation   String?
  careerUpside   String?
  interviewProb  String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  applications   Application[]

  @@index([company, title])
  @@index([fitScore])
  @@map("jobs")
}

model Application {
  id          String            @id @default(cuid())
  jobId       String?
  job         Job?              @relation(fields: [jobId], references: [id])
  company     String
  role        String
  url         String
  status      ApplicationStatus @default(discovered)
  fitScore    Float?
  compensationEstimate String?
  dateApplied DateTime?
  recruiterId String?
  recruiter   Recruiter?        @relation(fields: [recruiterId], references: [id])
  resumeId    String?
  resume      Resume?           @relation(fields: [resumeId], references: [id])
  notes       String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@unique([company, role])
  @@index([status])
  @@map("applications")
}

model Recruiter {
  id           String        @id @default(cuid())
  name         String
  company      String?
  linkedinUrl  String?
  message      String?
  createdAt    DateTime      @default(now())
  applications Application[]

  @@map("recruiters")
}

model Resume {
  id           String        @id @default(cuid())
  company      String
  template     String
  texPath      String
  pdfPath      String?
  keywords     String?
  createdAt    DateTime      @default(now())
  applications Application[]

  @@map("resumes")
}

model Run {
  id              String   @id @default(cuid())
  mode            String
  discoveredCount Int      @default(0)
  shortlistedCount Int     @default(0)
  preparedCount   Int      @default(0)
  appliedCount    Int      @default(0)
  llmPromptTokens Int      @default(0)
  llmCompletionTokens Int  @default(0)
  estimatedCostUsd Float   @default(0)
  summary          String?
  createdAt        DateTime @default(now())

  @@map("daily_runs")
}
